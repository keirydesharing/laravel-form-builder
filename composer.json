{
  "name": "kris/laravel-form-builder",
  "description": "Laravel form builder - symfony like",
  "license": "MIT",
  "authors": [
    {
      "name": "Kristijan Husak",
      "email": "husakkristijan@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.1",
    "laravelcollective/html": "^5.4|^6.0",
    "illuminate/support": "^6.0|^7.0|^8.0|^9.0|^10.0",
    "illuminate/database": "^6.0|^7.0|^8.0|^9.0|^10.0",
    "illuminate/validation": "^6.0|^7.0|^8.0|^9.0|^10.0"
  },
  "require-dev": {
    "phpunit/phpunit": "~4.0",
    "orchestra/testbench": "~3.0"
  },
  "extra": {
    "branch-alias": {
      "dev-master": "1.6.x-dev"
    }
  },
  "autoload": {
    "psr-0": {
      "Kris\\LaravelFormBuilder": "src/"
    },
    "classmap": [
      "tests/FormBuilderTestCase.php"
    ],
    "files": [
      "src/helpers.php"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
